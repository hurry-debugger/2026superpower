# Only explicitly owned paths inherit project settings.
root = true

[/{AGENTS.md,README.md,.editorconfig,.clang-format}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[/{docs,User,templates,tools}/**.{md,c,h,py,json,yaml,yml,toml,txt}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[/{User,templates}/**.{c,h}]
max_line_length = 100
